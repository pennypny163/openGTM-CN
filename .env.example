# OpenGTM 配置
# 复制此文件为 .env 并填入你的值

# 必需：LLM API密钥（支持任何OpenAI兼容端点）
OPENAI_API_KEY=your_api_key_here

# 必需：OpenAI兼容API的Base URL
# DeepSeek: https://api.deepseek.com/v1
# OpenAI: https://api.openai.com/v1
# 其他兼容端点均可
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名称（默认：deepseek-chat）
HUNYUAN_MODEL=deepseek-chat

# 可选：CRM同步 - 企业微信群机器人Webhook
CRM_WEBHOOK_URL=your_wecom_bot_webhook_url
CRM_WEBHOOK_TOKEN=your_webhook_auth_token

# 可选：消息语言（zh/en/de，默认：zh）
DEFAULT_LANGUAGE=zh

# 可选：每日最大连接请求数（默认：20）
DEFAULT_DAILY_LIMIT=20

# 可选：腾讯文档集成
# TENCENT_DOC_APP_ID=your_app_id
# TENCENT_DOC_APP_SECRET=your_app_secret
# TENCENT_DOC_SPREADSHEET_ID=your_spreadsheet_id
